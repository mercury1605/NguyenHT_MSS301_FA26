            "url": "{{gateway}}/api/order"
          }
        },
        {
          "name": "T8.4 POST order qty=101 -> 500 (khong phai 401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('T8.4 Qua duoc Gateway (khong phai 401)', () => pm.expect(pm.response.code).to.not.eql(401));",
            "pm.test('T8.4 Status 500 (hoac 409)', () => pm.expect([500, 409]).to.include(pm.response.code));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
