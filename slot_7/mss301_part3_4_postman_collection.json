          "name": "T3.3 Het hang qty=101 -> 500",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('T3.3 Status 500 (hoac 409 neu co GlobalExceptionHandler)', () => pm.expect([500, 409]).to.include(pm.response.code));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
