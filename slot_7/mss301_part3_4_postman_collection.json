          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{inventory}}/api/inventory?skuCode=iphone_15&quantity=100" }
        },
        {
          "name": "T2.2 iphone_15 qty=101 -> false",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('T2.2 Status 200', () => pm.response.to.have.status(200));",
            "pm.test('T2.2 Body = false', () => pm.expect(pm.response.text().trim()).to.eql('false'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{inventory}}/api/inventory?skuCode=iphone_15&quantity=101" }
        },
        {
