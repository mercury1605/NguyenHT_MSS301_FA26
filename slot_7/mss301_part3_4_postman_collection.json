    {
      "name": "3. Keycloak (T6)",
      "item": [
        {
          "name": "T6.3 Discovery document",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('T6.3 Status 200', () => pm.response.to.have.status(200));",
            "const d = pm.response.json();",
            "pm.test('T6.3 issuer dung', () => pm.expect(d.issuer).to.eql(pm.variables.get('keycloak')));",
            "pm.test('T6.3 co token_endpoint va jwks_uri', () => { pm.expect(d.token_endpoint).to.include('/protocol/openid-connect/token'); pm.expect(d.jwks_uri).to.include('/protocol/openid-connect/certs'); });",
            "pm.test('T6.3 ho tro client_credentials', () => pm.expect(d.grant_types_supported).to.include('client_credentials'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{keycloak}}/.well-known/openid-configuration" }
        },
        {
          "name": "T6.6 Sai secret -> 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('T6.6 Status 401', () => pm.response.to.have.status(401));",
            "pm.test('T6.6 error la unauthorized_client/invalid_client', () => pm.expect(['unauthorized_client', 'invalid_client']).to.include(pm.response.json().error));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "client_credentials" },
              { "key": "client_id", "value": "{{clientId}}" },
              { "key": "client_secret", "value": "sai-secret" }
            ]},
            "url": "{{keycloak}}/protocol/openid-connect/token"
          }
        },
        {
          "name": "T6.4 Lay token (Client Credentials)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "function decode(t) { const p = t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'); return JSON.parse(atob(p + '='.repeat((4 - p.length % 4) % 4))); }",
            "pm.test('T6.4 Status 200', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) {",
            "  const body = pm.response.json();",
            "  pm.collectionVariables.set('token', body.access_token);",
            "  console.log('expires_in =', body.expires_in);",
            "  pm.test('T6.4 token_type Bearer, expires_in > 0', () => { pm.expect(body.token_type).to.eql('Bearer'); pm.expect(body.expires_in).to.be.above(0); });",
            "  const c = decode(body.access_token);",
            "  pm.test('T6.4 iss khop issuer-uri', () => pm.expect(c.iss).to.eql(pm.variables.get('keycloak')));",
            "  pm.test('T6.4 azp = clientId', () => pm.expect(c.azp).to.eql(pm.variables.get('clientId')));",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "client_credentials" },
              { "key": "client_id", "value": "{{clientId}}" },
              { "key": "client_secret", "value": "{{clientSecret}}" }
            ]},
            "url": "{{keycloak}}/protocol/openid-connect/token"
          }
        },
        {
          "name": "T7.7 (chuan bi) Lay token qua 127.0.0.1",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "function decode(t) { const p = t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'); return JSON.parse(atob(p + '='.repeat((4 - p.length % 4) % 4))); }",
            "pm.test('T7.7 prep: lay duoc token qua 127.0.0.1', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) {",
            "  const t = pm.response.json().access_token;",
            "  pm.collectionVariables.set('tokenAlt', t);",
            "  pm.test('T7.7 prep: iss chua 127.0.0.1', () => pm.expect(decode(t).iss).to.include('127.0.0.1'));",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "client_credentials" },
              { "key": "client_id", "value": "{{clientId}}" },
              { "key": "client_secret", "value": "{{clientSecret}}" }
            ]},
            "url": "{{keycloakAlt}}/protocol/openid-connect/token"
          }
        }
      ]
    },
    {
      "name": "4. Gateway - bi chan (T7)",
      "item": [
        {
          "name": "T7.1 Khong token -> 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('T7.1 Status 401', () => pm.response.to.have.status(401));",
            "pm.test('T7.1 Co header WWW-Authenticate', () => pm.response.to.have.header('WWW-Authenticate'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{gateway}}/api/products" }
        },
        {
          "name": "T7.2 Token rac -> 401 invalid_token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('T7.2 Status 401', () => pm.response.to.have.status(401));",
            "pm.test('T7.2 WWW-Authenticate chua invalid_token', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('invalid_token'));"
          ]}}],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer abc.def.ghi" }], "url": "{{gateway}}/api/products" }
        },
        {
          "name": "T7.3 Token bi sua payload -> 401",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const parts = pm.variables.get('token').split('.');",
              "const p = parts[1];",
              "const i = Math.floor(p.length / 2);",
              "parts[1] = p.substring(0, i) + (p[i] === 'A' ? 'B' : 'A') + p.substring(i + 1);",
              "pm.variables.set('tamperedToken', parts.join('.'));"
            ]}},
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('T7.3 Status 401', () => pm.response.to.have.status(401));"
            ]}}
          ],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tamperedToken}}" }], "url": "{{gateway}}/api/products" }
        },
        {
          "name": "T7.5 POST order khong token -> 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('T7.5 Status 401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"skuCode\":\"iphone_15\",\"price\":1000,\"quantity\":1}" },
            "url": "{{gateway}}/api/order"
          }
        },
        {
          "name": "T7.6 Health public -> 200 UP",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('T7.6 Status 200', () => pm.response.to.have.status(200));",
            "pm.test('T7.6 status = UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{gateway}}/actuator/health" }
        },
        {
          "name": "T7.7 Token iss 127.0.0.1 -> 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('T7.7 Status 401 (iss khong khop)', () => pm.response.to.have.status(401));"
          ]}}],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{tokenAlt}}" }], "url": "{{gateway}}/api/products" }
        }
      ]
    },
